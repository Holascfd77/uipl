	box.FocusLost:Connect(function(enter)
		tween(s, { Color = Theme.Stroke }, 0.2)
		tween(box, { Size = UDim2.fromOffset(150, 26) }, 0.3)
		safe(o.Callback, box.Text, enter)
	end)

	local obj = {}
	function obj:Set(t)
		box.Text = t
	end
	function obj:Get()
		return box.Text
	end
	return obj
end

function TabMethods:CreateThemePicker(name)
	local win = self.Window
	return self:CreateList({
		Name = name or "Theme",
		Options = Library:GetThemes(),
		Default = Library.CurrentTheme,
		Callback = function(t)
			win:SetTheme(t)
		end,
	})
end

---------------------------------------------------------------- ventana

function Library:CreateWindow(o)
	o = o or {}
	local W, H = o.Width or 560, o.Height or 380
	local DOCK_W = 230
	local Window = { Tabs = {}, Minimized = false, Visible = true, _connections = {}, _refreshers = {} }

	applyTheme(o.Theme or Library.CurrentTheme)

	local gui = create("ScreenGui", {
		Name = "SmoothUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
	})
	gui.Parent = getParent()
	Window.Gui = gui

	-- contenedor (se mueve y cambia de tamano) con sombra
	local holder = create("Frame", {
		Name = "Holder",
		Size = UDim2.fromOffset(W, H),
		Position = UDim2.new(0.5, -W / 2, 0.5, -H / 2),
		BackgroundTransparency = 1,
	}, gui)
	local scale = create("UIScale", { Scale = 0.85 }, holder)

	local shadow = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 6),
		Size = UDim2.new(1, 70, 1, 70),
		BackgroundTransparency = 1,
		Image = "rbxassetid://6014261993",
		ImageColor3 = Color3.new(0, 0, 0),
		ImageTransparency = 1,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(49, 49, 450, 450),
		ZIndex = 0,
	}, holder)

	local main = create("CanvasGroup", {
		Name = "Main",
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		GroupTransparency = 1,
	}, holder)
	paint(Window, main, "BackgroundColor3", "Background")
	corner(main, 14)
	stroke(Window, main)

	-- barra superior
	local top = create("Frame", {
		Size = UDim2.new(1, 0, 0, 42),
		BorderSizePixel = 0,
	}, main)
	paint(Window, top, "BackgroundColor3", "TopBar")
	local accentLine = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
	}, top)
	gradient(Window, accentLine, 0)

	local logo = create("Frame", {
		Position = UDim2.fromOffset(14, 12),
		Size = UDim2.fromOffset(18, 18),
		BorderSizePixel = 0,
	}, top)
	corner(logo, 6)
	gradient(Window, logo, 45)
	local logoDot = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, logo)
	corner(logoDot, 3)

	local title = textLabel(Window, top, o.Title or "SmoothUI", 14, "Text", Enum.Font.GothamBold)
	title.Position = UDim2.fromOffset(40, 0)
	title.Size = UDim2.new(1, -118, 1, 0)
	title.TextTruncate = Enum.TextTruncate.AtEnd

	local function topButton(text, xOffset, colorKey)
		local b = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, xOffset, 0.5, 0),
			Size = UDim2.fromOffset(28, 28),
			BackgroundTransparency = 1,
			Text = text,
			TextSize = 14,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
		}, top)
		paint(Window, b, "BackgroundColor3", colorKey)
		paint(Window, b, "TextColor3", "SubText")
		corner(b, 8)
		b.MouseEnter:Connect(function()
			tween(b, { BackgroundTransparency = 0.1, TextColor3 = Color3.new(1, 1, 1) }, 0.15)
		end)
		b.MouseLeave:Connect(function()
			tween(b, { BackgroundTransparency = 1, TextColor3 = Theme.SubText }, 0.2)
		end)
		b.MouseButton1Down:Connect(function()
			tween(b, { Size = UDim2.fromOffset(24, 24) }, 0.08)
		end)
		b.MouseButton1Up:Connect(function()
			tween(b, { Size = UDim2.fromOffset(28, 28) }, 0.3, Enum.EasingStyle.Back)
		end)
		return b
	end
	local closeBtn = topButton("X", -10, "Danger")
	local minBtn = topButton("-", -42, "Accent")

	-- cuerpo (tamano fijo, lo recorta el contenedor al minimizar)
	local body = create("CanvasGroup", {
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.fromOffset(W, H - 42),
		BackgroundTransparency = 1,
	}, main)

	local sidebar = create("ScrollingFrame", {
		Size = UDim2.new(0, 136, 1, 0),
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
	}, body)
	paint(Window, sidebar, "BackgroundColor3", "Sidebar")
	create("UIListLayout", { Padding = UDim.new(0, 5) }, sidebar)
	create("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	}, sidebar)

	local pages = create("Frame", {
		Position = UDim2.fromOffset(144, 0),
		Size = UDim2.new(1, -144, 1, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
	}, body)

	-- abrir con animacion
	tween(main, { GroupTransparency = 0 }, 0.35)
	tween(shadow, { ImageTransparency = 0.55 }, 0.5)
	tween(scale, { Scale = 1 }, 0.55, Enum.EasingStyle.Back)

	-- arrastrar (y restaurar al tocar la barra si esta minimizada)
	local dragging, dragStart, startPos
	top.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if Window.Minimized then
				Window:Minimize(false)
				return
			end
			dragging = true
			dragStart = input.Position
			startPos = holder.Position
		end
	end)
	table.insert(Window._connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			tween(holder, {
				Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y),
			}, 0.08, Enum.EasingStyle.Linear)
		end
	end))
	table.insert(Window._connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	-- acciones de ventana
	function Window:Minimize(state)
		if state == nil then
			state = not self.Minimized
		end
		if state == self.Minimized then
			return
		end
		self.Minimized = state
		dragging = false
		if state then
			self._restorePos = holder.Position
			tween(body, { GroupTransparency = 1 }, 0.25)
			tween(holder, {
				Size = UDim2.fromOffset(DOCK_W, 42),
				Position = UDim2.new(0.5, -DOCK_W / 2, 0, 14),
			}, 0.55, Enum.EasingStyle.Quint)
			minBtn.Text = "+"
		else
			tween(body, { GroupTransparency = 0 }, 0.5)
			tween(holder, {
				Size = UDim2.fromOffset(W, H),
				Position = self._restorePos or UDim2.new(0.5, -W / 2, 0.5, -H / 2),
			}, 0.55, Enum.EasingStyle.Quint)
			minBtn.Text = "-"
		end
	end

	function Window:SetVisible(v)
		self.Visible = v
		if v then
			holder.Visible = true
			tween(main, { GroupTransparency = 0 }, 0.3)
			tween(shadow, { ImageTransparency = 0.55 }, 0.3)
			tween(scale, { Scale = 1 }, 0.45, Enum.EasingStyle.Back)
		else
			tween(main, { GroupTransparency = 1 }, 0.25)
			tween(shadow, { ImageTransparency = 1 }, 0.25)
			tween(scale, { Scale = 0.9 }, 0.25)
			task.delay(0.26, function()
				if not self.Visible then
					holder.Visible = false
				end
			end)
		end
	end

	function Window:SetTheme(t)
		applyTheme(t)
		self.ThemeName = Library.CurrentTheme
		for _, fn in ipairs(self._refreshers) do
			pcall(fn)
		end
	end

	function Window:Destroy()
		tween(main, { GroupTransparency = 1 }, 0.3)
		tween(shadow, { ImageTransparency = 1 }, 0.3)
		tween(scale, { Scale = 0.8 }, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.36, function()
			for _, c in ipairs(self._connections) do
				c:Disconnect()
			end
			gui:Destroy()
		end)
	end

	function Window:SetTitle(t)
		title.Text = t
	end

	closeBtn.MouseButton1Click:Connect(function()
		Window:Destroy()
	end)
	minBtn.MouseButton1Click:Connect(function()
		Window:Minimize()
	end)

	if o.ToggleKey then
		table.insert(Window._connections, UserInputService.InputBegan:Connect(function(input, gp)
			if not gp and input.KeyCode == o.ToggleKey then
				Window:SetVisible(not Window.Visible)
			end
		end))
	end

	-- notificaciones
	local toasts = create("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 290, 1, -32),
		BackgroundTransparency = 1,
	}, gui)
	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, toasts)

	function Window:Notify(n)
		n = n or {}
		local dur = n.Duration or 4
		local t = create("CanvasGroup", {
			Size = UDim2.new(1, 0, 0, 0),
			BorderSizePixel = 0,
			GroupTransparency = 1,
		}, toasts)
		paint(self, t, "BackgroundColor3", "Element")
		corner(t, 12)
		stroke(self, t)
		local tt = textLabel(self, t, n.Title or "Aviso", 13, "Text", Enum.Font.GothamBold)
		tt.Position = UDim2.fromOffset(14, 9)
		tt.Size = UDim2.new(1, -28, 0, 16)
		local tc = textLabel(self, t, n.Content or "", 12, "SubText", Enum.Font.Gotham)
		tc.Position = UDim2.fromOffset(14, 27)
		tc.Size = UDim2.new(1, -28, 0, 28)
		tc.TextWrapped = true
		tc.TextYAlignment = Enum.TextYAlignment.Top
		local bar = create("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 3),
			BorderSizePixel = 0,
		}, t)
		gradient(self, bar, 0)
		tween(t, { Size = UDim2.new(1, 0, 0, 66), GroupTransparency = 0 }, 0.45, Enum.EasingStyle.Back)
		tween(bar, { Size = UDim2.new(0, 0, 0, 3) }, dur, Enum.EasingStyle.Linear)
		task.delay(dur, function()
			tween(t, { Size = UDim2.new(1, 0, 0, 0), GroupTransparency = 1 }, 0.35)
			task.wait(0.4)
			t:Destroy()
		end)
	end

	-- pestanas
	function Window:CreateTab(name)
		local Tab = setmetatable({ Window = self, Name = name }, TabMethods)

		local btn = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundTransparency = 1,
			Text = name or "Tab",
			TextSize = 13,
			Font = Enum.Font.GothamMedium,
			AutoButtonColor = false,
		}, sidebar)
		paint(self, btn, "BackgroundColor3", "Element")
		corner(btn, 9)
		local indicator = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(3, 0),
			BorderSizePixel = 0,
		}, btn)
		corner(indicator, 2)
		gradient(self, indicator, 90)

		local page = create("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = false,
			ScrollBarThickness = 3,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
		}, pages)
		paint(self, page, "ScrollBarImageColor3", "Accent")
		create("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }, page)
		create("UIPadding", {
			PaddingTop = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 12),
		}, page)
		Tab.Page = page

		local active = false
		local function render()
			tween(btn, {
				BackgroundTransparency = active and 0 or 1,
				TextColor3 = active and Theme.Text or Theme.SubText,
			}, 0.25)
			tween(indicator, { Size = UDim2.fromOffset(3, active and 18 or 0) }, 0.35, Enum.EasingStyle.Back)
		end
		table.insert(self._refreshers, render)
		render()

		function Tab:_setActive(a)
			active = a
			render()
			if a then
				page.Position = UDim2.fromOffset(0, 18)
				page.Visible = true
				tween(page, { Position = UDim2.fromOffset(0, 0) }, 0.45)
			else
				page.Visible = false
			end
		end

		function Tab:Select()
			if Window.ActiveTab == Tab then
				return
			end
			if Window.ActiveTab then
				Window.ActiveTab:_setActive(false)
			end
			Window.ActiveTab = Tab
			Tab:_setActive(true)
		end

		btn.MouseEnter:Connect(function()
			if Window.ActiveTab ~= Tab then
				tween(btn, { TextColor3 = Theme.Text }, 0.15)
			end
		end)
		btn.MouseLeave:Connect(function()
			if Window.ActiveTab ~= Tab then
				tween(btn, { TextColor3 = Theme.SubText }, 0.2)
			end
		end)
		btn.MouseButton1Click:Connect(function()
			Tab:Select()
		end)

		table.insert(self.Tabs, Tab)
		if #self.Tabs == 1 then
			Tab:Select()
		end
		return Tab
	end

	Window.ThemeName = Library.CurrentTheme
	return Window
end

return Library
