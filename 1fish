function TabMethods:CreateToggle(o)
	o = o or {}
	local win = self.Window
	local state = o.Default == true
	local f = newElement(win, self.Page, 40)
	local b = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	}, f)
	local l = nameLabel(win, f, o.Name or "Toggle")
	l.Size = UDim2.new(1, -70, 1, 0)
	l.ZIndex = 2

	local track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(40, 22),
		BorderSizePixel = 0,
		ZIndex = 2,
	}, f)
	corner(track, 11)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 4, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 3,
	}, track)
	corner(knob, 7)

	interactive(win, f, b)

	local obj = {}
	local function render()
		tween(track, { BackgroundColor3 = state and Theme.Accent or Theme.Stroke }, 0.3)
		tween(knob, {
			Position = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 4, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
		}, 0.35, Enum.EasingStyle.Back)
	end
	function obj:Set(v, silent)
		state = v and true or false
		render()
		if not silent then
			safe(o.Callback, state)
		end
	end
	function obj:Get()
		return state
	end
	b.MouseButton1Down:Connect(function()
		tween(knob, { Size = UDim2.fromOffset(19, 14) }, 0.1)
	end)
	b.MouseButton1Click:Connect(function()
		obj:Set(not state)
	end)
	bind(win, render)
	if o.Default then
		safe(o.Callback, state)
	end
	return obj
end

function TabMethods:CreateSlider(o)
	o = o or {}
	local win = self.Window
	local min, max = o.Min or 0, o.Max or 100
	local inc = o.Increment or 1
	local suffix = o.Suffix or ""
	local value = math.clamp(o.Default or min, min, max)

	local f = newElement(win, self.Page, 58)
	local name = textLabel(win, f, o.Name or "Slider", 13, "Text")
	name.Position = UDim2.fromOffset(14, 7)
	name.Size = UDim2.new(1, -100, 0, 20)
	local valLabel = textLabel(win, f, "", 13, "SubText")
	valLabel.AnchorPoint = Vector2.new(1, 0)
	valLabel.Position = UDim2.new(1, -14, 0, 7)
	valLabel.Size = UDim2.fromOffset(80, 20)
	valLabel.TextXAlignment = Enum.TextXAlignment.Right

	local area = create("TextButton", {
		Position = UDim2.fromOffset(14, 32),
		Size = UDim2.new(1, -28, 0, 20),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, f)
	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 6),
		BorderSizePixel = 0,
	}, area)
	paint(win, bar, "BackgroundColor3", "Stroke")
	corner(bar, 3)
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
	}, bar)
	corner(fill, 3)
	gradient(win, fill, 0)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, bar)
	corner(knob, 6)
	local knobStroke = create("UIStroke", { Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, knob)
	paint(win, knobStroke, "Color", "Accent")

	local obj = {}
	local function render()
		local alpha = (max == min) and 0 or (value - min) / (max - min)
		tween(fill, { Size = UDim2.fromScale(alpha, 1) }, 0.12)
		tween(knob, { Position = UDim2.fromScale(alpha, 0.5) }, 0.12)
		valLabel.Text = tostring(math.floor(value * 1000 + 0.5) / 1000) .. suffix
	end
	function obj:Set(v, silent)
		v = math.floor((v - min) / inc + 0.5) * inc + min
		v = math.clamp(v, min, max)
		if v == value and not silent then
			return
		end
		value = v
		render()
		if not silent then
			safe(o.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	local dragging = false
	local function fromInput(input)
		local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		obj:Set(min + (max - min) * alpha)
	end
	area.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			tween(knob, { Size = UDim2.fromOffset(17, 17) }, 0.2, Enum.EasingStyle.Back)
			fromInput(input)
		end
	end)
	table.insert(win._connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromInput(input)
		end
	end))
	table.insert(win._connections, UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			tween(knob, { Size = UDim2.fromOffset(12, 12) }, 0.25, Enum.EasingStyle.Back)
		end
	end))

	render()
	return obj
end

function TabMethods:CreateList(o)
	o = o or {}
	local win = self.Window
	local options = o.Options or {}
	local current = o.Default
	local open = false
	local buttons = {}

	local f = newElement(win, self.Page, 40)
	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	}, f)
	local name = textLabel(win, f, o.Name or "List", 13, "Text")
	name.Position = UDim2.fromOffset(14, 0)
	name.Size = UDim2.new(0.5, -14, 0, 40)
	name.ZIndex = 2
	local valLabel = textLabel(win, f, current and tostring(current) or "...", 13, "SubText")
	valLabel.Position = UDim2.new(0.5, 0, 0, 0)
	valLabel.Size = UDim2.new(0.5, -38, 0, 40)
	valLabel.TextXAlignment = Enum.TextXAlignment.Right
	valLabel.TextTruncate = Enum.TextTruncate.AtEnd
	valLabel.ZIndex = 2
	local arrow = textLabel(win, f, "v", 12, "Accent", Enum.Font.GothamBold)
	arrow.AnchorPoint = Vector2.new(0.5, 0.5)
	arrow.Position = UDim2.new(1, -20, 0, 20)
	arrow.Size = UDim2.fromOffset(16, 16)
	arrow.TextXAlignment = Enum.TextXAlignment.Center
	arrow.ZIndex = 2

	local list = create("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 44),
		Size = UDim2.new(1, -16, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
	}, f)
	paint(win, list, "ScrollBarImageColor3", "Accent")
	create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, list)

	interactive(win, f, header)

	local function listHeight()
		return math.clamp(#options * 29 - 3, 0, 130)
	end
	local function applyOpen()
		local h = listHeight()
		tween(f, { Size = UDim2.new(1, 0, 0, open and (44 + h + 8) or 40) }, 0.4)
		tween(list, { Size = UDim2.new(1, -16, 0, open and h or 0) }, 0.4)
		tween(arrow, { Rotation = open and 180 or 0 }, 0.4, Enum.EasingStyle.Back)
	end

	local obj = {}
	local function recolor()
		for _, entry in ipairs(buttons) do
			tween(entry.button, {
				TextColor3 = entry.option == current and Theme.Accent or Theme.SubText,
				BackgroundColor3 = Theme.ElementHover,
			}, 0.25)
		end
	end
	table.insert(win._refreshers, recolor)

	function obj:Set(opt, silent)
		current = opt
		valLabel.Text = opt ~= nil and tostring(opt) or "..."
		recolor()
		if not silent then
			safe(o.Callback, opt)
		end
	end
	function obj:Get()
		return current
	end

	local function build()
		for _, entry in ipairs(buttons) do
			entry.button:Destroy()
		end
		table.clear(buttons)
		for i, opt in ipairs(options) do
			local b = create("TextButton", {
				Size = UDim2.new(1, -6, 0, 26),
				BackgroundColor3 = Theme.ElementHover,
				BackgroundTransparency = 1,
				Text = tostring(opt),
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				TextColor3 = opt == current and Theme.Accent or Theme.SubText,
				AutoButtonColor = false,
				LayoutOrder = i,
			}, list)
			corner(b, 7)
			b.MouseEnter:Connect(function()
				tween(b, { BackgroundTransparency = 0 }, 0.15)
			end)
			b.MouseLeave:Connect(function()
				tween(b, { BackgroundTransparency = 1 }, 0.2)
			end)
			b.MouseButton1Click:Connect(function()
				obj:Set(opt)
				open = false
				applyOpen()
			end)
			table.insert(buttons, { button = b, option = opt })
		end
	end

	function obj:Refresh(newOptions)
		options = newOptions or {}
		if current ~= nil and not table.find(options, current) then
			obj:Set(nil, true)
		end
		build()
		if open then
			applyOpen()
		end
	end

	header.MouseButton1Click:Connect(function()
		open = not open
		applyOpen()
	end)

	build()
	return obj
end

