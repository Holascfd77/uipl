local Theme = {}
Library.Theme = Theme
Library.CurrentTheme = "Dark"

local function applyTheme(t)
	local base = Library.Themes.Dark
	if type(t) == "string" then
		Library.CurrentTheme = Library.Themes[t] and t or "Dark"
		t = Library.Themes[Library.CurrentTheme]
	end
	for k, v in pairs(base) do
		Theme[k] = (t and t[k]) or v
	end
end
applyTheme("Dark")

function Library:GetThemes()
	local names = {}
	for n in pairs(Library.Themes) do
		table.insert(names, n)
	end
	table.sort(names)
	return names
end

---------------------------------------------------------------- helpers

local WHITE = Color3.new(1, 1, 1)

local function tween(obj, props, time, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function create(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(inst, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r or 10) }, inst)
end

local function safe(cb, ...)
	if not cb then
		return
	end
	task.spawn(function(...)
		local ok, err = pcall(cb, ...)
		if not ok then
			warn("[SmoothUI] " .. tostring(err))
		end
	end, ...)
end

local function getParent()
	if typeof(gethui) == "function" then
		local ok, h = pcall(gethui)
		if ok and h then
			return h
		end
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

-- una propiedad que sigue al theme
local function paint(win, inst, prop, key)
	inst[prop] = Theme[key]
	table.insert(win._refreshers, function()
		if inst.Parent then
			tween(inst, { [prop] = Theme[key] }, 0.35)
		end
	end)
end

-- una funcion que se vuelve a ejecutar al cambiar de theme
local function bind(win, fn)
	fn()
	table.insert(win._refreshers, fn)
end

-- gradiente Accent -> Accent2 sobre cualquier padre (Frame, UIStroke, TextLabel)
local function makeGradient(win, parent, rotation)
	local g = create("UIGradient", { Rotation = rotation or 0 }, parent)
	bind(win, function()
		g.Color = ColorSequence.new(Theme.Accent, Theme.Accent2)
	end)
	return g
end

-- igual, pero tambien pone el fondo en blanco para que se vea el gradiente
local function gradient(win, inst, rotation)
	inst.BackgroundColor3 = WHITE
	return makeGradient(win, inst, rotation)
end

local function stroke(win, inst, thickness)
	local s = create("UIStroke", {
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, inst)
	paint(win, s, "Color", "Stroke")
	return s
end

local function textLabel(win, parent, text, size, colorKey, font)
	local l = create("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size or 13,
		Font = font or Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, parent)
	paint(win, l, "TextColor3", colorKey or "Text")
	return l
end

-- onda que sale desde donde se hace click
local function ripple(win, frame)
	local sc = win._scale.Scale
	local mp = UserInputService:GetMouseLocation()
	local rel = (mp - frame.AbsolutePosition) / sc
	local size = frame.AbsoluteSize / sc
	if rel.X < 0 or rel.Y < 0 or rel.X > size.X or rel.Y > size.Y then
		rel = size / 2
	end
	local c = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(rel.X, rel.Y),
		Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = 1,
	}, frame)
	create("UICorner", { CornerRadius = UDim.new(1, 0) }, c)
	local d = math.max(size.X, size.Y) * 2.2
	tween(c, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 }, 0.6)
	task.delay(0.65, function()
		c:Destroy()
	end)
end

-- hover, pulsacion y destello para un elemento normal
local function interactive(win, frame, button)
	local uiScale = create("UIScale", { Scale = 1 }, frame)
	local flash = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 0,
	}, frame)
	corner(flash, 10)
	gradient(win, flash, 0)

	button.MouseEnter:Connect(function()
		tween(frame, { BackgroundColor3 = Theme.ElementHover }, 0.2)
	end)
	button.MouseLeave:Connect(function()
		tween(frame, { BackgroundColor3 = Theme.Element }, 0.25)
		tween(uiScale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
	end)
	button.MouseButton1Down:Connect(function()
		tween(uiScale, { Scale = 0.97 }, 0.1)
	end)
	button.MouseButton1Up:Connect(function()
		tween(uiScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
		flash.BackgroundTransparency = 0.82
		tween(flash, { BackgroundTransparency = 1 }, 0.5)
	end)
end

---------------------------------------------------------------- elementos

local TabMethods = {}
TabMethods.__index = TabMethods

local ROW = 42 -- alto estandar de un elemento

local function newElement(win, page, height, colorKey)
	local f = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, page)
	paint(win, f, "BackgroundColor3", colorKey or "Element")
	corner(f, 10)
	stroke(win, f)
	-- brillo suave arriba
	create("UIGradient", {
		Color = ColorSequence.new(WHITE, Color3.fromRGB(205, 205, 205)),
		Rotation = 90,
	}, f)
	return f
end

-- texto con nombre, alineado vertical al centro de una fila de ROW de alto
local function nameLabel(win, parent, text, rightPad)
	local l = textLabel(win, parent, text, 13, "Text")
	l.Position = UDim2.fromOffset(14, 0)
	l.Size = UDim2.new(1, -(14 + (rightPad or 14)), 0, ROW)
	return l
end

function TabMethods:CreateSection(text)
	local win = self.Window
	local f = create("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
	}, self.Page)
	local l = textLabel(win, f, string.upper(text or "SECTION"), 11, "SubText", Enum.Font.GothamBold)
	l.Position = UDim2.fromOffset(4, 0)
	l.Size = UDim2.new(1, -8, 0, 24)
	local line = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 1),
		BorderSizePixel = 0,
	}, f)
	local g = gradient(win, line, 0)
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	local obj = {}
	function obj:Set(t)
		l.Text = string.upper(t)
	end
	return obj
end

