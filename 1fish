-- Estilo nuevo: boton relleno con gradiente, texto centrado y onda al click
function TabMethods:CreateButton(o)
	o = o or {}
	local win = self.Window
	local outline = o.Style == "Outline"

	local f = create("CanvasGroup", {
		Size = UDim2.new(1, 0, 0, ROW),
		BorderSizePixel = 0,
	}, self.Page)
	corner(f, 12)
	local g
	if outline then
		paint(win, f, "BackgroundColor3", "Element")
		local s = create("UIStroke", { Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, f)
		makeGradient(win, s, 0)
	else
		g = gradient(win, f, 0)
	end

	local l = create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = o.Name or "Button",
		TextSize = 14,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextColor3 = WHITE,
		ZIndex = 2,
	}, f)
	if outline then
		paint(win, l, "TextColor3", "Text")
	end

	local b = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 3,
	}, f)

	local uiScale = create("UIScale", { Scale = 1 }, f)
	b.MouseEnter:Connect(function()
		if g then
			tween(g, { Rotation = 20 }, 0.4)
		else
			tween(f, { BackgroundColor3 = Theme.ElementHover }, 0.2)
		end
		tween(uiScale, { Scale = 1.015 }, 0.25)
	end)
	b.MouseLeave:Connect(function()
		if g then
			tween(g, { Rotation = 0 }, 0.4)
		else
			tween(f, { BackgroundColor3 = Theme.Element }, 0.25)
		end
		tween(uiScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
	end)
	b.MouseButton1Down:Connect(function()
		tween(uiScale, { Scale = 0.96 }, 0.1)
		ripple(win, f)
	end)
	b.MouseButton1Up:Connect(function()
		tween(uiScale, { Scale = 1.015 }, 0.3, Enum.EasingStyle.Back)
	end)
	b.MouseButton1Click:Connect(function()
		safe(o.Callback)
	end)

	local obj = {}
	function obj:SetName(t)
		l.Text = t
	end
	return obj
end

function TabMethods:CreateToggle(o)
	o = o or {}
	local win = self.Window
	local state = o.Default == true
	local f = newElement(win, self.Page, ROW)
	local b = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	}, f)
	local l = nameLabel(win, f, o.Name or "Toggle", 70)
	l.ZIndex = 2

	local track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(42, 22),
		BorderSizePixel = 0,
		ZIndex = 2,
	}, f)
	paint(win, track, "BackgroundColor3", "Stroke")
	corner(track, 11)
	local fill = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 3,
	}, track)
	corner(fill, 11)
	gradient(win, fill, 0)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 4, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 4,
	}, track)
	corner(knob, 7)

	interactive(win, f, b)

	local obj = {}
	local function render()
		tween(fill, { BackgroundTransparency = state and 0 or 1 }, 0.3)
		tween(knob, {
			Position = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 4, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
		}, 0.35, Enum.EasingStyle.Back)
	end
	function obj:Set(v, silent)
		state = v and true or false
		render()
		if not silent then
			safe(o.Callback, state)
		end
	end
	function obj:Get()
		return state
	end
	b.MouseButton1Down:Connect(function()
		tween(knob, { Size = UDim2.fromOffset(19, 14) }, 0.1)
	end)
	b.MouseButton1Click:Connect(function()
		obj:Set(not state)
	end)
	render()
	if o.Default then
		safe(o.Callback, state)
	end
	return obj
end

function TabMethods:CreateSlider(o)
	o = o or {}
	local win = self.Window
	local min, max = o.Min or 0, o.Max or 100
	local inc = o.Increment or 1
	local suffix = o.Suffix or ""
	local value = math.clamp(o.Default or min, min, max)

	local f = newElement(win, self.Page, 60)
	local name = textLabel(win, f, o.Name or "Slider", 13, "Text")
	name.Position = UDim2.fromOffset(14, 6)
	name.Size = UDim2.new(1, -110, 0, 22)
	local valLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 6),
		Size = UDim2.fromOffset(80, 22),
		BackgroundTransparency = 1,
		Text = "",
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, f)
	makeGradient(win, valLabel, 0) -- valor con gradiente

	local area = create("TextButton", {
		Position = UDim2.fromOffset(14, 32),
		Size = UDim2.new(1, -28, 0, 22),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, f)
	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 8),
		BorderSizePixel = 0,
	}, area)
	paint(win, bar, "BackgroundColor3", "Stroke")
	corner(bar, 4)
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
	}, bar)
	corner(fill, 4)
	gradient(win, fill, 0)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, bar)
	corner(knob, 7)
	local knobStroke = create("UIStroke", { Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, knob)
	makeGradient(win, knobStroke, 45)

	local obj = {}
	local function render()
		local alpha = (max == min) and 0 or (value - min) / (max - min)
		tween(fill, { Size = UDim2.fromScale(alpha, 1) }, 0.12)
		tween(knob, { Position = UDim2.fromScale(alpha, 0.5) }, 0.12)
		valLabel.Text = tostring(math.floor(value * 1000 + 0.5) / 1000) .. suffix
	end
	function obj:Set(v, silent)
		v = math.floor((v - min) / inc + 0.5) * inc + min
		v = math.clamp(v, min, max)
		if v == value and not silent then
			return
		end
		value = v
		render()
		if not silent then
			safe(o.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	local dragging = false
	local function fromInput(input)
		local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		obj:Set(min + (max - min) * alpha)
	end
	area.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			tween(knob, { Size = UDim2.fromOffset(19, 19) }, 0.2, Enum.EasingStyle.Back)
			fromInput(input)
		end
	end)
	table.insert(win._connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromInput(input)
		end
	end))
	table.insert(win._connections, UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.25, Enum.EasingStyle.Back)
		end
	end))

	render()
	return obj
end

