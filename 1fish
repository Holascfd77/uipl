	local f = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, page)
	paint(win, f, "BackgroundColor3", "Element")
	corner(f, 10)
	stroke(win, f)
	return f
end

