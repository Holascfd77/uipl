--[[
	SmoothUI | libreria de UI animada para Roblox (estilo Rayfield)

	Uso rapido:
		local UI = loadstring(...)()        -- o require(modulo) si es ModuleScript
		local Win = UI:CreateWindow({Title = "Mi UI", ToggleKey = Enum.KeyCode.RightShift})
		local Tab = Win:CreateTab("Main")
		Tab:CreateButton({Name = "Hola", Callback = function() print("hola") end})
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Library = {}

local Theme = {
	Background = Color3.fromRGB(22, 22, 28),
	Sidebar = Color3.fromRGB(26, 26, 33),
	TopBar = Color3.fromRGB(28, 28, 36),
	Element = Color3.fromRGB(34, 34, 44),
	ElementHover = Color3.fromRGB(46, 46, 60),
	Accent = Color3.fromRGB(110, 90, 255),
	Text = Color3.fromRGB(235, 235, 245),
	SubText = Color3.fromRGB(150, 150, 172),
	Stroke = Color3.fromRGB(55, 55, 72),
	Danger = Color3.fromRGB(235, 70, 80),
}
Library.Theme = Theme

---------------------------------------------------------------- helpers

local function tween(obj, props, time, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function create(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(inst, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r or 8) }, inst)
end

local function stroke(inst, color, thickness)
	return create("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, inst)
end

local function safe(cb, ...)
	if not cb then
		return
	end
	task.spawn(function(...)
		local ok, err = pcall(cb, ...)
		if not ok then
			warn("[SmoothUI] " .. tostring(err))
		end
	end, ...)
end

local function textLabel(parent, text, size, color, font)
	return create("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size or 13,
		TextColor3 = color or Theme.Text,
		Font = font or Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
end

local function getParent()
	if typeof(gethui) == "function" then
		local ok, h = pcall(gethui)
		if ok and h then
			return h
		end
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

-- animacion de hover + click suave para un elemento
local function interactive(frame, button)
	local uiScale = create("UIScale", { Scale = 1 }, frame)
	local flash = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 0,
	}, frame)
	corner(flash, 8)

	button.MouseEnter:Connect(function()
		tween(frame, { BackgroundColor3 = Theme.ElementHover }, 0.2)
	end)
	button.MouseLeave:Connect(function()
		tween(frame, { BackgroundColor3 = Theme.Element }, 0.25)
		tween(uiScale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
	end)
	button.MouseButton1Down:Connect(function()
		tween(uiScale, { Scale = 0.97 }, 0.1)
	end)
	button.MouseButton1Up:Connect(function()
		tween(uiScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
		flash.BackgroundTransparency = 0.75
		tween(flash, { BackgroundTransparency = 1 }, 0.45)
	end)
end

---------------------------------------------------------------- elementos

local TabMethods = {}
TabMethods.__index = TabMethods

local function newElement(page, height)
	local f = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, page)
	corner(f, 8)
	stroke(f)
	return f
end

local function nameLabel(parent, text)
	local l = textLabel(parent, text, 13)
	l.Position = UDim2.fromOffset(12, 0)
	l.Size = UDim2.new(1, -24, 0, 38)
	return l
end

function TabMethods:CreateSection(text)
	local l = textLabel(self.Page, string.upper(text or "SECTION"), 11, Theme.SubText, Enum.Font.GothamBold)
	l.Size = UDim2.new(1, 0, 0, 22)
	local pad = create("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 6) }, l)
	local obj = {}
	function obj:Set(t)
		l.Text = string.upper(t)
	end
	return obj
end

function TabMethods:CreateLabel(text)
	local f = newElement(self.Page, 32)
	local l = textLabel(f, text or "", 13, Theme.SubText)
	l.Position = UDim2.fromOffset(12, 0)
	l.Size = UDim2.new(1, -24, 1, 0)
	local obj = {}
	function obj:Set(t)
		l.Text = t
	end
	return obj
end

function TabMethods:CreateButton(o)
	o = o or {}
	local f = newElement(self.Page, 38)
	local b = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	}, f)
	local l = nameLabel(f, o.Name or "Button")
	l.ZIndex = 2
	local arrow = textLabel(f, ">", 14, Theme.Accent, Enum.Font.GothamBold)
	arrow.Size = UDim2.new(0, 20, 1, 0)
	arrow.Position = UDim2.new(1, -28, 0, 0)
	arrow.TextXAlignment = Enum.TextXAlignment.Center
	arrow.ZIndex = 2

	interactive(f, b)
	b.MouseEnter:Connect(function()
		tween(arrow, { Position = UDim2.new(1, -22, 0, 0) }, 0.25)
	end)
	b.MouseLeave:Connect(function()
		tween(arrow, { Position = UDim2.new(1, -28, 0, 0) }, 0.25)
	end)
	b.MouseButton1Click:Connect(function()
		safe(o.Callback)
	end)

	local obj = {}
	function obj:SetName(t)
		l.Text = t
	end
	return obj
end

function TabMethods:CreateToggle(o)
	o = o or {}
	local state = o.Default == true
	local f = newElement(self.Page, 38)
	local b = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	}, f)
	nameLabel(f, o.Name or "Toggle").ZIndex = 2

	local track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(38, 20),
		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, f)
	corner(track, 10)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		ZIndex = 3,
	}, track)
	corner(knob, 7)

	interactive(f, b)

	local obj = {}
	local function render()
		tween(track, { BackgroundColor3 = state and Theme.Accent or Theme.Stroke }, 0.25)
		tween(knob, {
			Position = state and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
		}, 0.3, Enum.EasingStyle.Back)
	end
	function obj:Set(v, silent)
		state = v and true or false
		render()
		if not silent then
			safe(o.Callback, state)
		end
	end
	function obj:Get()
		return state
	end
	b.MouseButton1Down:Connect(function()
		tween(knob, { Size = UDim2.fromOffset(18, 14) }, 0.1)
	end)
	b.MouseButton1Click:Connect(function()
		obj:Set(not state)
	end)
	render()
	if o.Default then
		safe(o.Callback, state)
	end
	return obj
end

function TabMethods:CreateSlider(o)
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local inc = o.Increment or 1
	local suffix = o.Suffix or ""
	local value = math.clamp(o.Default or min, min, max)

	local f = newElement(self.Page, 56)
	local name = textLabel(f, o.Name or "Slider", 13)
	name.Position = UDim2.fromOffset(12, 6)
	name.Size = UDim2.new(1, -90, 0, 20)
	local valLabel = textLabel(f, "", 13, Theme.SubText)
	valLabel.AnchorPoint = Vector2.new(1, 0)
	valLabel.Position = UDim2.new(1, -12, 0, 6)
	valLabel.Size = UDim2.fromOffset(80, 20)
	valLabel.TextXAlignment = Enum.TextXAlignment.Right

	local area = create("TextButton", {
		Position = UDim2.fromOffset(12, 30),
		Size = UDim2.new(1, -24, 0, 20),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, f)
	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
	}, area)
	corner(bar, 3)
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
	}, bar)
	corner(fill, 3)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
	}, bar)
	corner(knob, 6)

	local obj = {}
	local function render()
		local alpha = (max == min) and 0 or (value - min) / (max - min)
		tween(fill, { Size = UDim2.fromScale(alpha, 1) }, 0.12)
		tween(knob, { Position = UDim2.fromScale(alpha, 0.5) }, 0.12)
		valLabel.Text = tostring(math.floor(value * 1000 + 0.5) / 1000) .. suffix
	end
	function obj:Set(v, silent)
		v = math.floor((v - min) / inc + 0.5) * inc + min
		v = math.clamp(v, min, max)
		if v == value and not silent then
			return
		end
		value = v
		render()
		if not silent then
			safe(o.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	local dragging = false
	local function fromInput(input)
		local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		obj:Set(min + (max - min) * alpha)
	end
	area.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			tween(knob, { Size = UDim2.fromOffset(16, 16) }, 0.15, Enum.EasingStyle.Back)
			fromInput(input)
		end
	end)
	local c1 = UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromInput(input)
		end
	end)
	local c2 = UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			tween(knob, { Size = UDim2.fromOffset(12, 12) }, 0.2, Enum.EasingStyle.Back)
		end
	end)
	table.insert(self.Window._connections, c1)
	table.insert(self.Window._connections, c2)

	render()
	return obj
end

function TabMethods:CreateList(o)
	o = o or {}
	local options = o.Options or {}
	local current = o.Default
	local open = false
	local buttons = {}

	local f = newElement(self.Page, 38)
	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	}, f)
	local name = textLabel(f, o.Name or "List", 13)
	name.Position = UDim2.fromOffset(12, 0)
	name.Size = UDim2.new(0.5, -12, 0, 38)
	name.ZIndex = 2
	local valLabel = textLabel(f, current and tostring(current) or "...", 13, Theme.SubText)
	valLabel.Position = UDim2.new(0.5, 0, 0, 0)
	valLabel.Size = UDim2.new(0.5, -34, 0, 38)
	valLabel.TextXAlignment = Enum.TextXAlignment.Right
	valLabel.TextTruncate = Enum.TextTruncate.AtEnd
	valLabel.ZIndex = 2
	local arrow = textLabel(f, "v", 12, Theme.Accent, Enum.Font.GothamBold)
	arrow.AnchorPoint = Vector2.new(0.5, 0.5)
	arrow.Position = UDim2.new(1, -18, 0, 19)
	arrow.Size = UDim2.fromOffset(16, 16)
	arrow.TextXAlignment = Enum.TextXAlignment.Center
	arrow.ZIndex = 2

	local list = create("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 42),
		Size = UDim2.new(1, -16, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
	}, f)
	create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, list)

	interactive(f, header)

	local function listHeight()
		return math.clamp(#options * 29 - 3, 0, 130)
	end
	local function applyOpen()
		local h = listHeight()
		tween(f, { Size = UDim2.new(1, 0, 0, open and (42 + h + 8) or 38) }, 0.35)
		tween(list, { Size = UDim2.new(1, -16, 0, open and h or 0) }, 0.35)
		tween(arrow, { Rotation = open and 180 or 0 }, 0.35)
	end

	local obj = {}
	local function recolor()
		for _, entry in ipairs(buttons) do
			tween(entry.button, { TextColor3 = entry.option == current and Theme.Accent or Theme.SubText }, 0.2)
		end
	end
	function obj:Set(opt, silent)
		current = opt
		valLabel.Text = opt ~= nil and tostring(opt) or "..."
		recolor()
		if not silent then
			safe(o.Callback, opt)
		end
	end
	function obj:Get()
		return current
	end

	local function build()
		for _, entry in ipairs(buttons) do
			entry.button:Destroy()
		end
		table.clear(buttons)
		for i, opt in ipairs(options) do
			local b = create("TextButton", {
				Size = UDim2.new(1, -6, 0, 26),
				BackgroundColor3 = Theme.ElementHover,
				BackgroundTransparency = 1,
				Text = tostring(opt),
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				TextColor3 = opt == current and Theme.Accent or Theme.SubText,
				AutoButtonColor = false,
				LayoutOrder = i,
			}, list)
			corner(b, 6)
			b.MouseEnter:Connect(function()
				tween(b, { BackgroundTransparency = 0 }, 0.15)
			end)
			b.MouseLeave:Connect(function()
				tween(b, { BackgroundTransparency = 1 }, 0.2)
			end)
			b.MouseButton1Click:Connect(function()
				obj:Set(opt)
				open = false
				applyOpen()
			end)
			table.insert(buttons, { button = b, option = opt })
		end
	end

	function obj:Refresh(newOptions)
		options = newOptions or {}
		if current ~= nil and not table.find(options, current) then
			obj:Set(nil, true)
		end
		build()
		if open then
			applyOpen()
		end
	end

	header.MouseButton1Click:Connect(function()
		open = not open
		applyOpen()
	end)

	build()
	return obj
end

function TabMethods:CreateInput(o)
	o = o or {}
	local f = newElement(self.Page, 38)
	nameLabel(f, o.Name or "Input")
	local box = create("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(150, 24),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Text = o.Default or "",
		PlaceholderText = o.Placeholder or "...",
		PlaceholderColor3 = Theme.SubText,
		TextColor3 = Theme.Text,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		ClearTextOnFocus = false,
	}, f)
	corner(box, 6)
	local s = stroke(box)

	box.Focused:Connect(function()
		tween(s, { Color = Theme.Accent }, 0.2)
		tween(box, { Size = UDim2.fromOffset(170, 24) }, 0.3, Enum.EasingStyle.Back)
	end)
	box.FocusLost:Connect(function(enter)
		tween(s, { Color = Theme.Stroke }, 0.2)
		tween(box, { Size = UDim2.fromOffset(150, 24) }, 0.3)
		safe(o.Callback, box.Text, enter)
	end)

	local obj = {}
	function obj:Set(t)
		box.Text = t
	end
	function obj:Get()
		return box.Text
	end
	return obj
end

---------------------------------------------------------------- ventana

function Library:CreateWindow(o)
	o = o or {}
	local W, H = o.Width or 540, o.Height or 360
	local Window = { Tabs = {}, Minimized = false, Visible = true, _connections = {} }

	local gui = create("ScreenGui", {
		Name = "SmoothUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
	})
	gui.Parent = getParent()
	Window.Gui = gui

	local main = create("CanvasGroup", {
		Name = "Main",
		Size = UDim2.fromOffset(W, H),
		Position = UDim2.new(0.5, -W / 2, 0.5, -H / 2),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
	}, gui)
	corner(main, 12)
	stroke(main)
	local scale = create("UIScale", { Scale = 0.85 }, main)

	-- barra superior
	local top = create("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Theme.TopBar,
		BorderSizePixel = 0,
	}, main)
	create("Frame", {
		Size = UDim2.fromOffset(4, 16),
		Position = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
	}, top)
	corner(top.Frame, 2)
	local title = textLabel(top, o.Title or "SmoothUI", 14, Theme.Text, Enum.Font.GothamBold)
	title.Position = UDim2.fromOffset(26, 0)
	title.Size = UDim2.new(1, -110, 1, 0)

	local function topButton(text, xOffset, hoverColor)
		local b = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, xOffset, 0.5, 0),
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = hoverColor,
			BackgroundTransparency = 1,
			Text = text,
			TextColor3 = Theme.SubText,
			TextSize = 14,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
		}, top)
		corner(b, 7)
		b.MouseEnter:Connect(function()
			tween(b, { BackgroundTransparency = 0.15, TextColor3 = Theme.Text }, 0.15)
		end)
		b.MouseLeave:Connect(function()
			tween(b, { BackgroundTransparency = 1, TextColor3 = Theme.SubText }, 0.2)
		end)
		return b
	end
	local closeBtn = topButton("X", -8, Theme.Danger)
	local minBtn = topButton("-", -40, Theme.Accent)

	-- cuerpo
	local sidebar = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(0, 130, 1, -40),
		BackgroundColor3 = Theme.Sidebar,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
	}, main)
	create("UIListLayout", { Padding = UDim.new(0, 4) }, sidebar)
	create("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	}, sidebar)

	local pages = create("Frame", {
		Position = UDim2.fromOffset(138, 40),
		Size = UDim2.new(1, -138, 1, -40),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
	}, main)

	-- abrir con animacion
	tween(main, { GroupTransparency = 0 }, 0.35)
	tween(scale, { Scale = 1 }, 0.5, Enum.EasingStyle.Back)

	-- arrastrar
	local dragging, dragStart, startPos
	top.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end)
	table.insert(Window._connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			tween(main, {
				Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y),
			}, 0.08, Enum.EasingStyle.Linear)
		end
	end))
	table.insert(Window._connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	-- acciones de ventana
	function Window:Minimize(state)
		if state == nil then
			state = not self.Minimized
		end
		self.Minimized = state
		tween(main, { Size = UDim2.fromOffset(W, state and 40 or H) }, 0.4)
		minBtn.Text = state and "+" or "-"
	end

	function Window:SetVisible(v)
		self.Visible = v
		if v then
			main.Visible = true
			tween(main, { GroupTransparency = 0 }, 0.3)
			tween(scale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
		else
			tween(main, { GroupTransparency = 1 }, 0.25)
			tween(scale, { Scale = 0.9 }, 0.25)
			task.delay(0.26, function()
				if not self.Visible then
					main.Visible = false
				end
			end)
		end
	end

	function Window:Destroy()
		tween(main, { GroupTransparency = 1 }, 0.3)
		tween(scale, { Scale = 0.8 }, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.36, function()
			for _, c in ipairs(self._connections) do
				c:Disconnect()
			end
			gui:Destroy()
		end)
	end

	function Window:SetTitle(t)
		title.Text = t
	end

	closeBtn.MouseButton1Click:Connect(function()
		Window:Destroy()
	end)
	minBtn.MouseButton1Click:Connect(function()
		Window:Minimize()
	end)

	if o.ToggleKey then
		table.insert(Window._connections, UserInputService.InputBegan:Connect(function(input, gp)
			if not gp and input.KeyCode == o.ToggleKey then
				Window:SetVisible(not Window.Visible)
			end
		end))
	end

	-- notificaciones
	local toasts = create("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 280, 1, -32),
		BackgroundTransparency = 1,
	}, gui)
	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, toasts)

	function Window:Notify(n)
		n = n or {}
		local dur = n.Duration or 4
		local t = create("CanvasGroup", {
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundColor3 = Theme.Element,
			BorderSizePixel = 0,
			GroupTransparency = 1,
		}, toasts)
		corner(t, 10)
		stroke(t)
		local tt = textLabel(t, n.Title or "Aviso", 13, Theme.Text, Enum.Font.GothamBold)
		tt.Position = UDim2.fromOffset(12, 8)
		tt.Size = UDim2.new(1, -24, 0, 16)
		local tc = textLabel(t, n.Content or "", 12, Theme.SubText, Enum.Font.Gotham)
		tc.Position = UDim2.fromOffset(12, 26)
		tc.Size = UDim2.new(1, -24, 0, 26)
		tc.TextWrapped = true
		tc.TextYAlignment = Enum.TextYAlignment.Top
		local bar = create("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
		}, t)
		tween(t, { Size = UDim2.new(1, 0, 0, 62), GroupTransparency = 0 }, 0.4, Enum.EasingStyle.Back)
		tween(bar, { Size = UDim2.new(0, 0, 0, 2) }, dur, Enum.EasingStyle.Linear)
		task.delay(dur, function()
			tween(t, { Size = UDim2.new(1, 0, 0, 0), GroupTransparency = 1 }, 0.35)
			task.wait(0.4)
			t:Destroy()
		end)
	end

	-- pestanas
	function Window:CreateTab(name)
		local Tab = setmetatable({ Window = self, Name = name }, TabMethods)

		local btn = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundColor3 = Theme.Element,
			BackgroundTransparency = 1,
			Text = name or "Tab",
			TextColor3 = Theme.SubText,
			TextSize = 13,
			Font = Enum.Font.GothamMedium,
			AutoButtonColor = false,
		}, sidebar)
		corner(btn, 8)
		local indicator = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(3, 0),
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
		}, btn)
		corner(indicator, 2)

		local page = create("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = false,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Accent,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
		}, pages)
		create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, page)
		create("UIPadding", {
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
			PaddingLeft = UDim.new(0, 4),
			PaddingRight = UDim.new(0, 10),
		}, page)
		Tab.Page = page

		local function setActive(active)
			tween(btn, { BackgroundTransparency = active and 0 or 1, TextColor3 = active and Theme.Text or Theme.SubText }, 0.25)
			tween(indicator, { Size = UDim2.fromOffset(3, active and 16 or 0) }, 0.3, Enum.EasingStyle.Back)
			if active then
				page.Position = UDim2.fromOffset(0, 16)
				page.Visible = true
				tween(page, { Position = UDim2.fromOffset(0, 0) }, 0.4)
			else
				page.Visible = false
			end
		end

		function Tab:Select()
			if Window.ActiveTab == Tab then
				return
			end
			if Window.ActiveTab then
				Window.ActiveTab._setActive(false)
			end
			Window.ActiveTab = Tab
			setActive(true)
		end
		Tab._setActive = setActive

		btn.MouseEnter:Connect(function()
			if Window.ActiveTab ~= Tab then
				tween(btn, { TextColor3 = Theme.Text }, 0.15)
			end
		end)
		btn.MouseLeave:Connect(function()
			if Window.ActiveTab ~= Tab then
				tween(btn, { TextColor3 = Theme.SubText }, 0.2)
			end
		end)
		btn.MouseButton1Click:Connect(function()
			Tab:Select()
		end)

		table.insert(self.Tabs, Tab)
		if #self.Tabs == 1 then
			Tab:Select()
		end
		return Tab
	end

	return Window
end



return Library
