	arrow.ZIndex = 2

	local list = create("ScrollingFrame", {
		Position = UDim2.fromOffset(8, ROW + 4),
		Size = UDim2.new(1, -16, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
	}, f)
	paint(win, list, "ScrollBarImageColor3", "Accent")
	create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, list)

	interactive(win, f, header)

	local function listHeight()
		return math.clamp(#options * 29 - 3, 0, 130)
	end
	local function applyOpen()
		local h = listHeight()
		tween(f, { Size = UDim2.new(1, 0, 0, open and (ROW + 4 + h + 8) or ROW) }, 0.4)
		tween(list, { Size = UDim2.new(1, -16, 0, open and h or 0) }, 0.4)
		tween(arrow, { Rotation = open and 180 or 0 }, 0.4, Enum.EasingStyle.Back)
	end

	local obj = {}
	local function recolor()
		for _, entry in ipairs(buttons) do
			tween(entry.button, {
				TextColor3 = entry.option == current and Theme.Accent or Theme.SubText,
				BackgroundColor3 = Theme.ElementHover,
			}, 0.25)
		end
	end
	table.insert(win._refreshers, recolor)

	function obj:Set(opt, silent)
		current = opt
		valLabel.Text = opt ~= nil and tostring(opt) or "..."
		recolor()
		if not silent then
			safe(o.Callback, opt)
		end
	end
	function obj:Get()
		return current
	end

	local function build()
		for _, entry in ipairs(buttons) do
			entry.button:Destroy()
		end
		table.clear(buttons)
		for i, opt in ipairs(options) do
			local b = create("TextButton", {
				Size = UDim2.new(1, -6, 0, 26),
				BackgroundColor3 = Theme.ElementHover,
				BackgroundTransparency = 1,
				Text = tostring(opt),
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				TextColor3 = opt == current and Theme.Accent or Theme.SubText,
				AutoButtonColor = false,
				LayoutOrder = i,
			}, list)
			corner(b, 7)
			b.MouseEnter:Connect(function()
				tween(b, { BackgroundTransparency = 0 }, 0.15)
			end)
			b.MouseLeave:Connect(function()
				tween(b, { BackgroundTransparency = 1 }, 0.2)
			end)
			b.MouseButton1Click:Connect(function()
				obj:Set(opt)
				open = false
				applyOpen()
			end)
			table.insert(buttons, { button = b, option = opt })
		end
	end

	function obj:Refresh(newOptions)
		options = newOptions or {}
		if current ~= nil and not table.find(options, current) then
			obj:Set(nil, true)
		end
		build()
		if open then
			applyOpen()
		end
	end

	header.MouseButton1Click:Connect(function()
		open = not open
		applyOpen()
	end)

	build()
	return obj
end

-- Lista desplegable que contiene elementos (sliders, botones, toggles, etc)
function TabMethods:CreateList(o)
	o = o or {}
	local win = self.Window
	local open = o.Open == true

	local f = newElement(win, self.Page, ROW, "Sidebar")
	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, ROW),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	}, f)

	local dot = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0, ROW / 2),
		Size = UDim2.fromOffset(8, 8),
		BorderSizePixel = 0,
		ZIndex = 2,
	}, f)
	corner(dot, 4)
	gradient(win, dot, 45)

	local name = textLabel(win, f, o.Name or "List", 13, "Text", Enum.Font.GothamBold)
	name.Position = UDim2.fromOffset(30, 0)
	name.Size = UDim2.new(1, -66, 0, ROW)
	name.ZIndex = 2

	local arrow = textLabel(win, f, "v", 12, "Accent", Enum.Font.GothamBold)
	arrow.AnchorPoint = Vector2.new(0.5, 0.5)
	arrow.Position = UDim2.new(1, -20, 0, ROW / 2)
	arrow.Size = UDim2.fromOffset(16, 16)
	arrow.TextXAlignment = Enum.TextXAlignment.Center
	arrow.ZIndex = 2

	local line = create("Frame", {
		Position = UDim2.fromOffset(10, ROW),
		Size = UDim2.new(1, -20, 0, 1),
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
	}, f)
	local lg = gradient(win, line, 0)
	lg.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})

	local content = create("Frame", {
		Position = UDim2.fromOffset(0, ROW + 6),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
	}, f)
	local layout = create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, content)
	create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, content)

	local function targetHeight()
		local h = layout.AbsoluteContentSize.Y / win._scale.Scale
		return open and (ROW + 6 + h + 10) or ROW
	end

	local obj = setmetatable({ Window = win, Page = content }, TabMethods)

	function obj:SetOpen(state)
		open = state and true or false
		tween(f, { Size = UDim2.new(1, 0, 0, targetHeight()) }, 0.4)
		tween(arrow, { Rotation = open and 180 or 0 }, 0.4, Enum.EasingStyle.Back)
		tween(line, { BackgroundTransparency = open and 0.4 or 1 }, 0.3)
	end
	function obj:Toggle()
		obj:SetOpen(not open)
	end

	-- si cambia lo de adentro (dropdowns, etc), ajusta el alto al instante
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		if open then
			f.Size = UDim2.new(1, 0, 0, targetHeight())
		end
	end)

	header.MouseButton1Click:Connect(function()
		obj:Toggle()
	end)

	line.BackgroundTransparency = open and 0.4 or 1
	arrow.Rotation = open and 180 or 0
	task.defer(function()
		if open then
			f.Size = UDim2.new(1, 0, 0, targetHeight())
		end
	end)
	return obj
end

function TabMethods:CreateInput(o)
	o = o or {}
	local win = self.Window
	local f = newElement(win, self.Page, ROW)
	nameLabel(win, f, o.Name or "Input", 170).Size = UDim2.new(0.5, -14, 0, ROW)
	local box = create("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(150, 26),
		BorderSizePixel = 0,
		Text = o.Default or "",
		PlaceholderText = o.Placeholder or "...",
		Font = Enum.Font.Gotham,
		TextSize = 12,
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, f)
	paint(win, box, "BackgroundColor3", "Background")
	paint(win, box, "TextColor3", "Text")
	paint(win, box, "PlaceholderColor3", "SubText")
	corner(box, 8)
	create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, box)
	local s = stroke(win, box)

	box.Focused:Connect(function()
		tween(s, { Color = Theme.Accent }, 0.2)
		tween(box, { Size = UDim2.fromOffset(172, 26) }, 0.35, Enum.EasingStyle.Back)
